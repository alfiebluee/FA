# Aircraft position provider: adsblol | mock
AIRCRAFT_PROVIDER=adsblol
ADSB_LOL_BASE_URL=https://api.adsb.lol

# Observation point (Alexandra Park, public reference location) — kept server-side where possible;
# NEXT_PUBLIC_ values are needed for map display but the UI does not
# show precise coordinates by default.
NEXT_PUBLIC_OBSERVER_LAT=51.59568
NEXT_PUBLIC_OBSERVER_LON=-0.12603
NEXT_PUBLIC_TARGET_AIRPORT=EGLL
NEXT_PUBLIC_SEARCH_RADIUS_NM=35
NEXT_PUBLIC_REFRESH_INTERVAL_MS=8000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Flight details provider: none | fr24 (placeholder — requires credentials)
FLIGHT_DETAILS_PROVIDER=none
FR24_API_KEY=
FR24_BASE_URL=
